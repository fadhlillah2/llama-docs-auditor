# High-Precision Contract Advisor RAG - Environment Configuration
# Copy this file to .env and configure the values for your deployment

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================

# Flask environment mode
# Options: development, production
# Default: development
FLASK_ENV=development

# Flask secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED for production
FLASK_SECRET_KEY=your-secret-key-here-change-in-production

# Flask debug mode
# Options: True, False
# Default: False (recommended for production)
FLASK_DEBUG=False

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port
# Default: 8081
SERVER_PORT=8081

# Server host (for production deployment)
# Default: 127.0.0.1 (development), 0.0.0.0 (production)
SERVER_HOST=127.0.0.1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API Keys for authentication (production only)
# Comma-separated list of valid API keys
# Example: API_KEYS=key1,key2,key3
API_KEYS=

# CORS allowed origins (production)
# Comma-separated list of allowed domains
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# SSL/TLS Configuration (production)
# Path to SSL certificate file
SSL_CERT_PATH=cert.pem

# Path to SSL private key file
SSL_KEY_PATH=key.pem

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file upload size in bytes
# Default: 16777216 (16MB)
MAX_UPLOAD_SIZE=16777216

# Secure upload directory (production)
# Default: /var/lib/contract-advisor/uploads (production), ../data/uploads (development)
SECURE_UPLOAD_DIR=/var/lib/contract-advisor/uploads

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Ollama server URL
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
# Options: qwen3:1.7b, llama2, mistral, deepseek-r1:8b, codellama
# Default: qwen3:1.7b
OLLAMA_MODEL_NAME=qwen3:1.7b

# Ollama request timeout (seconds)
# Default: 300 (5 minutes)
OLLAMA_TIMEOUT=300

# =============================================================================
# GROQ CONFIGURATION
# =============================================================================
# Groq API Key for LLM inference
# Get your API key from https://console.groq.com/keys
# REQUIRED for Groq integration
GROQ_API_KEY=your-groq-api-key-here

# Groq model name
# Options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Default: llama-3.3-70b-versatile
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Groq request timeout (seconds)
# Default: 300 (5 minutes)
GROQ_TIMEOUT=300

# =============================================================================
# VECTOR STORE CONFIGURATION
# =============================================================================

# ChromaDB vector store path
# Default: ../data/chroma_db
VECTOR_DB_PATH=../data/chroma_db

# ChromaDB collection name
# Default: contract_documents
CHROMA_COLLECTION_NAME=contract_documents

# Embedding model for vector store
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================

# Embedding cache directory
# Default: ../cache/embeddings
EMBEDDING_CACHE_DIR=../cache/embeddings

# Query result cache directory
# Default: ../cache/queries
QUERY_CACHE_DIR=../cache/queries

# Cache expiration time (seconds)
# Default: 86400 (24 hours)
CACHE_EXPIRATION=86400

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================

# Session timeout (minutes)
# Default: 30
SESSION_TIMEOUT_MINUTES=30

# Session cleanup interval (minutes)
# Default: 10
SESSION_CLEANUP_INTERVAL=10

# Maximum concurrent sessions per IP
# Default: 5
MAX_SESSIONS_PER_IP=5

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# File upload rate limits
# Default: 5 requests per 300 seconds (5 minutes)
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW=300

# Query rate limits
# Default: 30 requests per 60 seconds (1 minute)
RATE_LIMIT_QUERY_REQUESTS=30
RATE_LIMIT_QUERY_WINDOW=60

# General API rate limits
# Default: 100 requests per 60 seconds (1 minute)
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable experimental features
FEATURE_HYBRID_SEARCH=True
FEATURE_QUERY_CACHING=True
FEATURE_BATCH_PROCESSING=True
FEATURE_ASYNC_EMBEDDINGS=True

# Enable advanced analytics
FEATURE_PERFORMANCE_MONITORING=True
FEATURE_USAGE_ANALYTICS=False

# Enable debug features (development only)
FEATURE_DEBUG_LOGGING=False
FEATURE_VERBOSE_ERRORS=False

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log file path
# Default: logs/app.log
LOG_FILE=logs/app.log

# Log rotation
# Default: True
LOG_ROTATION=True

# Maximum log file size (MB)
# Default: 10
LOG_MAX_SIZE=10

# Number of backup log files
# Default: 5
LOG_BACKUP_COUNT=5

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Enable health check endpoint
# Default: True
HEALTH_CHECK_ENABLED=True

# Enable metrics collection
# Default: True
METRICS_ENABLED=True

# Metrics endpoint path
# Default: /metrics
METRICS_ENDPOINT=/metrics

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable development tools
DEV_TOOLS_ENABLED=False

# Enable hot reload for configuration
DEV_CONFIG_HOT_RELOAD=False

# Enable test endpoints
DEV_TEST_ENDPOINTS=False

# =============================================================================
# DATABASE CONFIGURATION (Future Use)
# =============================================================================

# Database URL (if implementing persistent storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/contract_advisor

# Database connection pool size
# DATABASE_POOL_SIZE=5

# Database connection timeout
# DATABASE_TIMEOUT=30

# =============================================================================
# EXTERNAL SERVICES (Future Use)
# =============================================================================

# Email configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Cloud storage configuration (for document backup)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=contract-advisor-documents
# AWS_REGION=us-east-1

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env in the same directory
# 2. Fill in the required values marked as "REQUIRED"
# 3. Adjust optional values based on your deployment needs
# 4. Keep .env file secure and never commit it to version control
# 5. Restart the application after changing environment variables
# 6. Some configuration changes may require clearing caches

# For production deployment:
# - Set FLASK_ENV=production
# - Configure API_KEYS with secure random keys
# - Set ALLOWED_ORIGINS to your domain(s)
# - Configure SSL certificates for HTTPS
# - Use secure upload directory outside web root
# - Enable logging and monitoring features